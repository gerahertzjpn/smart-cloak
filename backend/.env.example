# 設定の例。自分のPCでは、このファイルを .env にコピーして必要なところだけ書き換える。
# .env は Git に入らない（.gitignore 済み）。パスワードは絶対にこのファイル（.env.example）に書かないこと。
#
# 何も設定しなくても、自分のPCでは動く：
#   DB   → PC内の PGlite（backend/.data/pglite）
#   写真 → backend/.data/photos
#   メール → 送信しない（画面のQRを使う）

# PORT=8080

# --- スタッフ用パスコード（設定すると画面を開くときにパスコードが必要になる）---
# STAFF_PASSCODE=

# --- メール送信（引換券）---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=cloak@example.com

# --- Cloud SQL（クラウドでは Cloud Run の設定で渡す。docs/deploy.md を参照）---
# DB_HOST=/cloudsql/project-pjwork12-ai07ae:asia-northeast1:smart-cloak-db
# DB_NAME=smartcloak
# DB_USER=app_user
# DB_PASSWORD=

# --- Cloud Storage（写真）---
# PHOTO_BUCKET=

# --- メールに書く URL（未設定ならアクセスされたURLを使う）---
# PUBLIC_URL=https://example.run.app
